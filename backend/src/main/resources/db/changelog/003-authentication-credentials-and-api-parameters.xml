<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">
  <changeSet id="003-authentication-credentials-and-api-parameters" author="mimir">
    <addColumn tableName="authentication">
      <column name="authentication_user" type="varchar(255)"/>
      <column name="authentication_credential" type="varchar(255)"/>
    </addColumn>
    <createTable tableName="api_parameter">
      <column name="parameter_id" type="varchar(255)"><constraints primaryKey="true" nullable="false"/></column>
      <column name="interface_id" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="parameter_name" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="parameter_value" type="varchar(255)"/>
    </createTable>
    <addForeignKeyConstraint constraintName="fk_api_parameter_interface" baseTableName="api_parameter" baseColumnNames="interface_id" referencedTableName="source_system_interface" referencedColumnNames="interface_name" onDelete="RESTRICT" onUpdate="RESTRICT"/>
    <createIndex tableName="api_parameter" indexName="idx_api_parameter_interface"><column name="interface_id"/></createIndex>
  </changeSet>
</databaseChangeLog>
