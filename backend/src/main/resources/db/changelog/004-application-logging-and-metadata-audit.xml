<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">
  <changeSet id="004-application-logging-and-metadata-audit" author="mimir">
    <createTable tableName="application_log">
      <column name="log_id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
      <column name="occurred_at" type="timestamp(6)"><constraints nullable="false"/></column>
      <column name="log_level" type="varchar(5)"><constraints nullable="false"/></column>
      <column name="source_name" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="message" type="varchar(2048)"><constraints nullable="false"/></column>
    </createTable>
    <createIndex tableName="application_log" indexName="idx_application_log_time">
      <column name="occurred_at"/>
    </createIndex>
    <createTable tableName="metadata_audit">
      <column name="audit_id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
      <column name="occurred_at" type="timestamp(6)"><constraints nullable="false"/></column>
      <column name="operation" type="varchar(10)"><constraints nullable="false"/></column>
      <column name="entity_type" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="record_id" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="details" type="clob"><constraints nullable="false"/></column>
    </createTable>
    <createIndex tableName="metadata_audit" indexName="idx_metadata_audit_time">
      <column name="occurred_at"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
